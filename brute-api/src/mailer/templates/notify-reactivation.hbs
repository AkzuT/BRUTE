<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        {{> styles}}
    </head>
    <body style="font-family: Roboto Condensed, sans-serif; line-height: 1.6; color: #000000">
        <div style="max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ffffff;">
            {{> header}}
            <div class="info-case">
                <h2>¡Hola, {{name}}!</h2>
                <p>
                    Tu cuenta ha sido reactivada exitosamente. A partir de este momento, podrás volver a 
                    iniciar sesión en tu cuenta con normalidad.
                </p>
                <div class="button-case">
                    <p style="text-align: center;">
                        <a href="" class="button" style="text-decoration: none;">INICIAR SESIÓN</a>
                    </p>
                </div>
            </div>
            {{> footer}}
        </div>
    </body>
</html>